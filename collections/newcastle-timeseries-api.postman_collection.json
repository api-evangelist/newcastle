        {
          "id": "97218e76-59c3-4350-90da-bbfc0f03e0b5",
          "name": "Request historic data from a timeseries by its unique ID and a date range",
          "request": {
            "name": "Request historic data from a timeseries by its unique ID and a date range",
            "description": {
              "content": "A date range may be specified to obtain historic readings from a timeseries, or the last 24 hours will be provided by default.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2.0a",
                "sensors",
                "timeseries",
                ":id",
                "historic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "24 hours in past",
                  "description": "Start period for the historic data to be retrieved, inclusive."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "24 hours in future",
                  "description": "End period for the historic data to be retrieved, inclusive."
                },
                {
                  "disabled": false,
                  "key": "outputAs",
                  "value": "json",
                  "description": "Output format for the data, although JSON is always recommended and CSV outputs are computed from JSON."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Timeseries ID to retrieve historic data for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },

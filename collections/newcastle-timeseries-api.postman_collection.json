{
  "item": [
    {
      "id": "acac3e07-4e31-4f45-838d-db58e2119d56",
      "name": "Timeseries",
      "description": {
        "content": "There may be more than one timeseries associated with a feed, provided for convenience. Ordinarily there will be a plain timeseries, representing raw data from the device. In some cases, there may then be additional timeseries representing converted values (e.g. scaled), corrected, or aggregated temporally.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "325aeecb-efbd-4a36-8a44-ff8ba338a672",
          "name": "Request a single timeseries by its unique ID",
          "request": {
            "name": "Request a single timeseries by its unique ID",
            "description": {
              "content": "A single timeseries and its current value will be returned, if recent, provided a valid ID is supplied and permissions permit.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2.0a",
                "sensors",
                "timeseries",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Timeseries ID to retrieve description and latest observed value for."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
